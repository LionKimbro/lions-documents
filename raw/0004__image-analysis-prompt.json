      "color_harmony": "",
      "saturation": "",
      "value_range": "",
      "color_temperature": "",
      "symbolic_color_meanings": {},
      "color_usage_patterns": ""
    },
    "light_and_shadow": {
      "light_source": "",
      "lighting_style": "",
      "shadow_behavior": "",
      "reflections": "",
      "translucency_effects": "",
      "symbolic_use_of_light": ""
    },
    "line_and_drawing": {
